{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunday-service-cn",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunday-service-db",
      "database_id": "855de3b1-1b83-4fa3-af58-07903c113fea"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sunday-service-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
